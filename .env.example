# ============================================================
# Option 1: Azure Key Vault (RECOMMENDED for production)
# Set this and the app fetches all secrets from Key Vault.
# The VM's Managed Identity must have "Key Vault Secrets User" role.
# ============================================================
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net

# ============================================================
# Option 2: Direct env vars (for local dev or fallback)
# These are IGNORED when Key Vault is configured and reachable.
# ============================================================
# DATABASE_URL=postgresql+asyncpg://user:pass@server.postgres.database.azure.com:5432/lucknow_bowls?ssl=require
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=uploads

# Server (always from env, not Key Vault)
HOST=0.0.0.0
PORT=8000

# JWT (required for auth; use a long random string in production)
# JWT_SECRET=

# OAuth (optional — leave blank to disable that provider)
# Google: Web client ID used to verify ID tokens (comma-separated for multiple audiences)
# GOOGLE_OAUTH_CLIENT_ID=
# Facebook: app id + secret for token validation
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Instagram Basic Display: app id + secret + redirect URI (must match Meta app settings)
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_REDIRECT_URI=https://your-frontend-host/oauth/instagram
